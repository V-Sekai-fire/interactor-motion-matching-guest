    given-names: Robin
  - family-names: Ramesh
    given-names: Shyam Sundhar
  - family-names: Bogunovic
    given-names: Ilija
  - family-names: Lucchi
    given-names: Aurelien
  year: 2026
  doi: 10.48550/arXiv.2609.35426
